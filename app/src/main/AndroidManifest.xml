<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to decide whether an incoming number belongs to a saved contact. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Only used for the optional "a call was blocked" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Genuinely required, not merely used: an app that screens incoming calls has
         nothing to do on a device that cannot receive them. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        tools:ignore="UnusedAttribute"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BlockedCallsActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".CallBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
